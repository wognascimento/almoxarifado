<Window x:Class="Almoxarifado.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Almoxarifado" 
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        mc:Ignorable="d"
        Title="SISTEMA INTEGRADO DE GERENCIAMENTO - ALMOXARIFADO"
        Height="450" Width="800" WindowState="Maximized" Loaded="Window_Loaded">


    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <telerik:RadMenu Grid.Row="0">

            <telerik:RadMenuItem Header="Cadastro">
                <telerik:RadMenuItem Header="Atendentes" Click="OnCadastroAtendenteClick"/>
                <telerik:RadMenuItem Header="Terceiros" Click="OnCadastroTerceiro"/>
                <telerik:RadMenuItem Header="Bolsa" Click="OnCadastroBolsa"/>
                <telerik:RadMenuItem Header="Bolsa Fixa" Click="OnCadastroBocaFixa"/>
                <telerik:RadMenuItem Header="Senha Cadeado" Click="OnSenhaCadeadoClick"/>
            </telerik:RadMenuItem>

            <telerik:RadMenuItem Header="Movimentações">

                <telerik:RadMenuItem Header="Saída" Click="OnAlmoxSaidaClick"/>
                <telerik:RadMenuItem Header="Entrada" Click="OnAlmoxEntradaClick"/>

                <telerik:RadMenuItem Header="Bolsa de Ferramenta">

                    <telerik:RadMenuItem Header="Saída" Click="OnBolsaSaidaClick"/>
                    <telerik:RadMenuItem Header="Entrada" Click="OnBolsaEntradaClick"/>

                </telerik:RadMenuItem>
                
            </telerik:RadMenuItem>

            <telerik:RadMenuItem Header="Consultas">
                <telerik:RadMenuItem Header="Produtos Almoxarifado" Click="OnProdutosAlmoxarifado"/>
                <telerik:RadMenuItem Header="Movimentações de Saída" Click="OnMovSaida"/>
                <telerik:RadMenuItem Header="Movimentações de Entrada" Click="OnMovEntrada"/>
                <telerik:RadMenuItem Header="Saldo Funcionário" Click="OnSaldoFuncionarioClick"/>
                <telerik:RadMenuItem Header="Ponto de Pedido" Click="OnPontoPedidoClick"/>
                <telerik:RadMenuItem Header="Saldo Estoque" Click="OnSaldoEstoqueClick"/>
                <telerik:RadMenuItem Header="Bolsa de Ferramenta" Click="OnMovBolsaClick"/>



            </telerik:RadMenuItem>

            <telerik:RadMenuItem Header="Outros">
                <telerik:RadMenuItem Header="Atualizar Sistema" Click="OnAtualizarSistemaClick"/>
            </telerik:RadMenuItem>
        </telerik:RadMenu>

        <telerik:RadDocking
            x:Name="radDocking"
            Grid.Row="1"
            HasDocumentHost="True">
            <telerik:RadDocking.DocumentHost>
                <telerik:RadSplitContainer>
                    <telerik:RadPaneGroup x:Name="documentGroup"/>
                </telerik:RadSplitContainer>
            </telerik:RadDocking.DocumentHost>
        </telerik:RadDocking>


        <StatusBar Grid.Row="2">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="4*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <StatusBarItem>
                <Image Source="/icones/icons8-usu_0025c3_0025a1rio-de-g_0025c3_0025aanero-neutro-windows-metro-16.png" Width="16" Height="16" MouseDown="OnAlterarUsuario"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="1">
                <TextBlock x:Name="txtUsername"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="2">
                <telerik:RadProgressBar x:Name="PbLoading" Height="20" Width="100" IsIndeterminate="True" Visibility="Hidden"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="3">
                <Image Source="/icones/configuracao-de-dados-windows-metro-16.png" Width="16" Height="16" MouseDown="OnAlterarAno"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="4">
                <TextBlock x:Name="txtDataBase"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Modal Overlay - Adicionar no final, antes de fechar </Grid> -->
        <Grid x:Name="ModalOverlay" 
          Background="#80000000" 
          Visibility="Collapsed"
          Panel.ZIndex="10000"
          MouseDown="ModalOverlay_MouseDown">

            <Canvas x:Name="ModalCanvas">
                <Border x:Name="ModalContainer"
                    Background="White"
                    BorderBrush="#CCCCCC"
                    BorderThickness="2"
                    CornerRadius="8"
                    Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Direction="315" 
                                      ShadowDepth="10" Opacity="0.3" BlurRadius="15"/>
                    </Border.Effect>

                    <ContentPresenter x:Name="ModalContent" />
                </Border>
            </Canvas>
        </Grid>

    </Grid>


</Window>

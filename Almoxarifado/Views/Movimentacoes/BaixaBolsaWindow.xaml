<Window x:Class="Almoxarifado.Views.Movimentacoes.BaixaBolsaWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:t="http://schemas.telerik.com/2008/xaml/presentation"
 Title="Baixa em estoque" Width="780" Height="570" MinWidth="620" MinHeight="430"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Loaded="Carregar" Closing="AoFechar">
 <Grid Margin="12" x:Name="conteudo">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <TextBlock x:Name="funcionarioTexto" FontWeight="Bold" Margin="0,0,0,10" TextWrapping="Wrap"/>
  <Grid Grid.Row="1" Margin="0,0,0,8">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <StackPanel><t:Label x:Name="destinoTitulo" Content="Destino"/><t:RadComboBox x:Name="destino" IsEditable="False"/></StackPanel>
   <StackPanel Grid.Column="2"><t:Label Content="Atendente"/><t:RadComboBox x:Name="atendente" IsEditable="False"/></StackPanel>
  </Grid>
  <Grid Grid.Row="2" Margin="0,0,0,8">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,8,0"><t:Label Content="O.S."/><t:RadWatermarkTextBox x:Name="ordem"/></StackPanel>
   <StackPanel Grid.Column="1" Margin="0,0,8,0"><t:Label Content="Endereco"/><t:RadWatermarkTextBox x:Name="endereco" MaxLength="12"/></StackPanel>
   <StackPanel Grid.Column="2"><t:Label Content="Data"/><t:RadDatePicker x:Name="data" IsEnabled="False"/></StackPanel>
   <StackPanel Grid.Column="3" x:Name="estadoPanel" Visibility="Collapsed" Width="110" Margin="8,0,0,0"><t:Label Content="Estado"/><t:RadComboBox x:Name="estado" IsEditable="False"/></StackPanel>
  </Grid>
  <TextBlock x:Name="aviso" Grid.Row="3" Margin="0,0,0,8" TextWrapping="Wrap"
   Text="Ao finalizar, os itens de todas as bolsas deste funcionario incluidos nesta baixa ficarao bloqueados para alteracao e nova baixa."/>
  <t:RadGridView Grid.Row="4" x:Name="produtos" IsReadOnly="True" AutoGenerateColumns="False"
   CanUserInsertRows="False" CanUserDeleteRows="False" ShowGroupPanel="False">
   <t:RadGridView.Columns>
    <t:GridViewDataColumn Header="Codigo" DataMemberBinding="{Binding Produto}" Width="85"/>
    <t:GridViewDataColumn Header="Descricao" DataMemberBinding="{Binding Descricao}" Width="*"/>
    <t:GridViewDataColumn x:Name="quantidadeColuna" Header="Quantidade" DataMemberBinding="{Binding Quantidade}" DataFormatString="{}{0:N2}" Width="130"/>
   </t:RadGridView.Columns>
  </t:RadGridView>
  <DockPanel Grid.Row="5" Margin="0,10,0,0">
   <t:RadButton DockPanel.Dock="Right" Content="Cancelar" Click="Cancelar" Margin="8,0,0,0"/>
   <t:RadButton DockPanel.Dock="Right" x:Name="confirmar" Content="Finalizar baixa" Click="Confirmar" IsEnabled="False"/>
   <TextBlock x:Name="status" TextWrapping="Wrap" Margin="0,0,8,0"/>
  </DockPanel>
 </Grid>
</Window>
